# ---------------------------------------------------------------- 构建产物
# Nuitka 输出：build/ 下有 *.build / *.dist / *.onefile-build / *.exe
build/
*.exe
*.pyd

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-*/
venv/
pip-unpack-*/
# pip 在 Windows 上失败时会在 cwd 留下这几种空目录，名字里带随机后缀，
# 用通配把它们一并挡掉（2026-11-12 在根目录发现三个）
pip-build-tracker-*/
pip-ephem-wheel-cache-*/
pip-install-*/
# 自测沙箱：`tempfile.gettempdir()` 在某些环境下会返回相对路径，
# 于是 `<tmp>/dsh-launcher-test-cfg` 落到 cwd。挡掉，别让它进仓库。
dsh-launcher-test-cfg/

# ---------------------------------------------------------------- 运行期数据
# 桌面壳真实数据在 %LOCALAPPDATA%\DSH-Web\，不进仓库；
# 这里的规则是防止本地调试时误提交。
logs/
webview-data/
*.log

# ---------------------------------------------------------------- 本地探针
nuitka-crash-report.xml
speedtest.txt
# 自测残留（contract/gui/datatask 跑完可能留下临时根，失败时故意保留供排查）
.tmp-selftest/
dl-selftest-*/
dsh-datatask-*/
build/probe-results/

# ---------------------------------------------------------------- 工作区记忆
# 含本机环境细节（路径 / 安装位置），不作为项目产物发布
.workbuddy/

# ---------------------------------------------------------------- 编辑器
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
